# Supabase configuration
# URL + anon key: Supabase dashboard -> Settings -> API
SUPABASE_URL=
SUPABASE_KEY=

# PostgreSQL connection string: Supabase dashboard -> Settings -> Database
# -> Connection string -> URI
SUPABASE_DB_URL=

# Groq API key (required for the IVY AI assistant)
GROQ_API_KEY=
GROQ_MODEL=

# Flask session secret - use a long random string
SECRET_KEY=

# Port for the local server (default: 5001)
PORT=

# Google Sign-In (optional). Create an OAuth Client ID at
# https://console.cloud.google.com -> OAuth consent screen -> Credentials.
# Authorized redirect URI:
#   http://127.0.0.1:5001/login/google/callback     (local)
#   https://<your-domain>/login/google/callback     (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WebRTC (recommended for production calls)
STUN_SERVER=
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# Email (SMTP) — used for verification and password reset.
# In development without SMTP config, all emails are printed to the console.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=